  "shared_property_types": [
    {
      "type_id": "EvidenceRef",
      "description": "指向教材正文片段的文字证据引用。只用于文字上下文溯源，不再区分来源类型，也不承载任何图像信息；图像走 FigureRef。",
      "fields": [
        {
          "name": "source_path",
          "value_type": "string",
          "required": true
        },
        {
          "name": "section",
          "value_type": "object",
          "required": true
        },
        {
          "name": "quote_or_summary",
          "value_type": "string",
          "required": true
        }
      ]
    },
    {
      "type_id": "FigureRef",
      "description": "教材图像作为 node/edge 内在组成的引用。核心是可溯源定位图片(figure_id+image_path)；图挂在哪个 node/edge 上即表达其作用，无需文字说明。description 为图片文字快照，便于无图场景的下游消费。",
      "fields": [
        {
          "name": "figure_id",
          "value_type": "string",
          "required": true
        },
        {
          "name": "image_path",
          "value_type": "string",
          "required": true
        },
        {
          "name": "name",
          "value_type": "string",
          "required": false
        },
        {
          "name": "description",
          "value_type": "string",
          "required": false
        }
      ]
    },
    {
      "type_id": "RuleStatement",
      "description": "知识点内部的规则或性质描述，不默认独立成 node label。",
      "fields": [
        {
          "name": "statement",
          "value_type": "string",
          "required": true
        },
        {
          "name": "conditions",
          "value_type": "string",
          "required": false
        }
      ]
    },
    {
      "type_id": "MethodStep",
      "description": "知识点或题目内部的方法步骤，不默认独立成 node label。",
      "fields": [
        {
          "name": "step_text",
          "value_type": "string",
          "required": true
        },
        {
          "name": "order",
          "value_type": "integer",
          "required": false
        }
      ]
    },
    {
      "type_id": "ChemicalEquationRef",
      "description": "化学反应方程式的标准化表示，包含反应物、生成物和反应条件。用于KnowledgePoint的formulas或quantity_relationships属性。",
      "fields": [
        {
          "name": "equation_text",
          "value_type": "string",
          "required": true
        },
        {
          "name": "reactants",
          "value_type": "list[string]",
          "required": true
        },
        {
          "name": "products",
          "value_type": "list[string]",
          "required": true
        },
        {
          "name": "conditions",
          "value_type": "string",
          "required": false
        },
        {
          "name": "reaction_type",
          "value_type": "string",
          "required": false
        }
      ]
    },
    {
      "type_id": "EnhancedUnitRef",
      "description": "化学学科特有的单位参考，支持摩尔浓度、物质的量等化学计量单位。",
      "fields": [
        {
          "name": "unit_name",
          "value_type": "string",
          "required": true
        },
        {
          "name": "symbol",
          "value_type": "string",
          "required": true
        },
        {
          "name": "quantity_type",
          "value_type": "string",
          "required": true
        },
        {
          "name": "dimensional_formula",
          "value_type": "string",
          "required": false
        },
        {
          "name": "conversion_factors",
          "value_type": "object",
          "required": false
        }
      ]
    },
    {
      "type_id": "EnhancedExperimentRef",
      "description": "化学实验活动的详细参考，包含实验目的、步骤、仪器和安全注意事项。",
      "fields": [
        {
          "name": "experiment_name",
          "value_type": "string",
          "required": true
        },
        {
          "name": "purpose",
          "value_type": "string",
          "required": true
        },
        {
          "name": "steps",
          "value_type": "list[MethodStep]",
          "required": true
        },
        {
          "name": "instruments",
          "value_type": "list[ToolRef]",
          "required": false
        },
        {
          "name": "safety_notes",
          "value_type": "list[string]",
          "required": false
        },
        {
          "name": "expected_observations",
          "value_type": "list[string]",
          "required": false
        }
      ]
    }
  ],
  "evidence_policy": {
    "default_role": "evidence_property",
    "default_shape": "EvidenceRef",
    "figure_shape": "FigureRef",
    "promotion_rule": "Evidence can become an independent node label only when it must be independently audited, manually annotated, or reused across many nodes/edges.",
    "image_rule": "图像一律通过 FigureRef 进入 KG，挂在对应 node/edge 的 figures 属性下，永不进入 EvidenceRef。"
  },
  "confidence_policy": {
    "range": "0-1",
    "precision": 2
  },
  "extraction_boundaries": [
    "IPA note 是图片经视觉模型文本化的结果，不是教材正文本体；其作用是判断该图属于哪个 node/edge 后作为 FigureRef 挂入其 figures，与 EvidenceRef 无关。",
    "图像一律通过 FigureRef 进入 KG，永不进入 EvidenceRef；EvidenceRef 只承载文字上下文证据。",
    "Do not extract KG facts from low/uncertain or failed IPA notes.",
    "Property-like candidates are node/edge properties unless a strong promotion_reason is provided."
  ]
}