      "label_zh": "知识点",
      "description": "教材中的可抽取知识单元，是数学 KG 的核心 node label。",
      "identity_rule": "有稳定名称、定义或可归一化表达，并可被章节、题目或其他知识点引用。",
      "properties": [
        {
          "name": "name",
          "value_type": "string",
          "required": true
        },
        {
          "name": "definition",
          "value_type": "string",
          "required": false
        },
        {
          "name": "description",
          "value_type": "string",
          "required": false
        },
        {
          "name": "aliases",
          "value_type": "list[string]",
