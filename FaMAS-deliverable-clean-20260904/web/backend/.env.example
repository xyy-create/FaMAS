# FaMAS / Shumai Web backend environment reference.
# Copy the names you need into your shell, service manager, or server environment.
# Do not put real secrets in this tracked example file.

# -----------------------------------------------------------------------------
# Secrets and authentication
# -----------------------------------------------------------------------------

# Required when the first admin account does not exist yet.
FAMAS_ADMIN_PASSWORD=<set-first-start-admin-password>

# Required. Keep this stable after users, sessions, or API keys are created.
FAMAS_SECRET_KEY=<set-long-random-secret-key>

# Optional but recommended. Keep stable after model API keys are saved.
# If omitted, FAMAS_SECRET_KEY is reused for API-key encryption.
FAMAS_SECRET_ENCRYPTION_KEY=<set-long-random-encryption-key>

# Optional comma-separated list used only when rotating FAMAS_SECRET_ENCRYPTION_KEY.
FAMAS_LEGACY_SECRET_ENCRYPTION_KEYS=

FAMAS_AUTH_COOKIE_NAME=famas_access_token
FAMAS_ACCESS_TOKEN_EXPIRE_MINUTES=120
FAMAS_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
FAMAS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# -----------------------------------------------------------------------------
# Runtime mode and access
# -----------------------------------------------------------------------------

# development: local development. public: temporary public review. production: formal server.
FAMAS_RUNTIME_MODE=development

# 1 exposes local diagnostics in system settings. Use 0 for public/production.
FAMAS_ENABLE_DIAGNOSTICS=1

# immediate: users can register and log in immediately.
# approval: users register as pending and must be approved by admin.
FAMAS_REGISTRATION_MODE=immediate

# Leave empty during local development. Set to the tunnel/domain URL for public access.
FAMAS_PUBLIC_URL=

# Optional CORS list for dual-port development or external frontend hosting.
FAMAS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# Database and migrations
# -----------------------------------------------------------------------------

# Default when omitted or empty: sqlite:///web/storage/famas_web.db
# FAMAS_DATABASE_URL=sqlite:///F:/path/to/web/storage/famas_web.db
# FAMAS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/famas

# 1 lets the backend apply Alembic migrations on startup.
FAMAS_AUTO_MIGRATE_DATABASE=1

# 1 keeps local SQLite fallback table creation available for development.
FAMAS_AUTO_CREATE_TABLES=1

# -----------------------------------------------------------------------------
# Uploads and pipeline jobs
# -----------------------------------------------------------------------------

# 2 MiB chunks balance progress visibility and tunnel stability.
FAMAS_UPLOAD_CHUNK_SIZE_BYTES=2097152

# 250 MiB default upload limit. Tune reverse proxy limits to match this on servers.
FAMAS_MAX_UPLOAD_BYTES=262144000

# Optional when the backend or pipeline should call a specific Python interpreter.
FAMAS_BACKEND_PYTHON=
FAMAS_PIPELINE_PYTHON=

# kg runs the full pipeline. Earlier stops are useful only for debugging.
FAMAS_PIPELINE_STOP_AT=kg

# 0 means real FaMAS pipeline and real model API calls.
# 1 means mock pipeline for quick UI tests.
FAMAS_PIPELINE_MOCK=0

# Reuse schema outputs when possible to reduce repeated SA-stage cost.
FAMAS_PIPELINE_SCHEMA_CACHE_ENABLED=1

# Persistent in-process worker settings for local/single-machine runs.
FAMAS_PIPELINE_WORKER_ENABLED=1
FAMAS_PIPELINE_WORKER_INTERVAL_SECONDS=2
FAMAS_PIPELINE_WORKER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# MinerU / GPU
# -----------------------------------------------------------------------------

MINERU_MODEL_SOURCE=local

# auto chooses GPU when the local environment supports it.
MINERU_DEVICE_MODE=auto
