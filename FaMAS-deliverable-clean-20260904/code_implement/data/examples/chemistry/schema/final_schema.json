        {
          "name": "methods",
          "value_type": "list[MethodStep]",
          "required": false
        },
        {
          "name": "quantity_relationships",
          "value_type": "list[QuantityRelationship]",
          "required": false
        },
        {
          "name": "tools",
          "value_type": "list[MathToolRef]",
          "required": false
        },
        {
          "name": "examples",
          "value_type": "list[ExampleRef]",
          "required": false
        },
        {
          "name": "figures",
          "value_type": "list[FigureRef]",
          "required": false
        },
        {
          "name": "evidence",
          "value_type": "list[EvidenceRef]",
          "required": true
        },
        {
          "name": "confidence",
          "value_type": "float",
          "required": true
        }
      ],
      "positive_examples": [
        "多位数",
        "计数单位",
        "三位数乘两位数"
      ],
      "negative_examples": [
        "页眉页脚",
        "装饰图"
      ]
